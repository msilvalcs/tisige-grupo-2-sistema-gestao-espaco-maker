{
  "name": "siges",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @siges/api\" \"npm run dev -w @siges/web\"",
    "build": "npm run build -w @siges/web",
    "start": "npm start -w @siges/api",
    "db:migrate": "npm run db:migrate -w @siges/api",
    "db:seed": "npm run db:seed -w @siges/api",
    "test": "node --test tests/api.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "db:local": "node scripts/local-db.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "^17.6.0-beta.15",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.10"
  }
}
